# DeepSeek
DEEPSEEK_API_KEY=
# Optional; defaults to deepseek-v4-flash
DEEPSEEK_MODEL=deepseek-v4-flash

# Jev input guardrail (fails open with a warning if unavailable)
OPENROUTER_API_KEY=
# Optional; defaults to jev-1.13
# JEV_MODEL=jev-1.13

# Shared per-user weekly AI cost cap in USD; default $1. Zero blocks paid calls.
# Resets Monday 00:00 UTC. Includes Jev, DeepSeek replies/tool rounds, and titles.
AI_WEEKLY_COST_CAP_USD=1
# Optional DeepSeek USD / 1M token prices (default Flash peak rates below).
# Set all three for an unrecognized DEEPSEEK_MODEL; update when pricing changes.
# DEEPSEEK_INPUT_USD_PER_MILLION=0.3
# DEEPSEEK_CACHED_INPUT_USD_PER_MILLION=0.006
# DEEPSEEK_OUTPUT_USD_PER_MILLION=1.2
# Optional maximum Jev fee to reserve before each audit; default $0.002.
# Increase for a JEV_MODEL with higher pricing. Actual OpenRouter usage.cost is charged.
# JEV_REQUEST_RESERVE_USD=0.002

# Set off to enable the app. Unset or any other value keeps maintenance on.
# Keep this unset in Vercel until ready to open production.
MAINTENANCE_MODE=off

# Upstash Redis (chat history, per-user rate limits and weekly AI budgets)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Upstash Vector index with hosted embeddings and OTC label text stored as data
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Existing Lucia / DynamoDB auth
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TABLE_NAME=

NEXT_PUBLIC_APP_NAME=Converse

# Resend auth emails (verified sending domain required)
RESEND_API_KEY=
EMAIL_FROM="Converse <no-reply@converse.signature-estate.online>"
# Optional trusted link origin; never inferred from request headers.
# APP_URL=http://localhost:3000
